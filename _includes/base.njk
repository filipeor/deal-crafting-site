<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% if title %}{{ title }} — {% endif %}deal.crafting</title>
<meta name="description" content="{{ description or 'deal.crafting — M&A, dívida e equity no mercado brasileiro.' }}">
<link rel="icon" href="data:,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;500;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/style.css">
</head>
<body>

<header class="masthead">
  <div class="masthead-top">
    <a href="/" class="logo-mark"><img src="/assets/logo-crop.png" alt="deal.crafting"></a>
    <nav class="masthead-nav">
      <a href="/" {% if nav == "home" %}class="active"{% endif %}>Home</a>
      <a href="/noticias/" {% if nav == "noticias" %}class="active"{% endif %}>Notícias</a>
      <a href="/deals/" {% if nav == "deals" %}class="active"{% endif %}>Deals</a>
      <a href="/sobre/" {% if nav == "sobre" %}class="active"{% endif %}>Sobre</a>
    </nav>
    <div class="masthead-actions">
      <span class="masthead-date">{{ hoje.longa }}</span>
      <a href="/#newsletter" class="btn-subscribe">Assinar</a>
      <button class="nav-toggle" aria-label="Abrir menu">☰</button>
    </div>
  </div>
  <div class="macro-bar" id="macro-bar">
    <div class="macro-item" data-metric="usd">
      <span class="macro-label">Dólar</span>
      <span class="macro-value">--</span>
      <span class="macro-change"></span>
    </div>
    <span class="macro-sep">•</span>
    <div class="macro-item" data-metric="eur">
      <span class="macro-label">Euro</span>
      <span class="macro-value">--</span>
      <span class="macro-change"></span>
    </div>
    <span class="macro-sep">•</span>
    <div class="macro-item" data-metric="selic">
      <span class="macro-label">Selic</span>
      <span class="macro-value">--</span>
    </div>
    <span class="macro-sep">•</span>
    <div class="macro-item" data-metric="ipca">
      <span class="macro-label">IPCA 12m</span>
      <span class="macro-value">--</span>
    </div>
    <span class="macro-updated" id="macro-updated"></span>
  </div>
</header>

<main class="wrap">
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <img src="/assets/logo-crop.png" alt="deal.crafting">
        <p>Jornalismo de mercado de capitais focado em fusões e aquisições, dívida e equity no Brasil.</p>
      </div>
      <div class="footer-col">
        <h4>Seções</h4>
        <a href="/">Home</a>
        <a href="/noticias/">Notícias</a>
        <a href="/deals/">Deals</a>
        <a href="/sobre/">Sobre</a>
      </div>
      <div class="footer-col">
        <h4>Categorias</h4>
        <a href="/noticias/">M&amp;A</a>
        <a href="/noticias/">Dívida</a>
        <a href="/noticias/">Equity</a>
        <a href="/noticias/">Regulação</a>
      </div>
      <div class="footer-col">
        <h4>Contato</h4>
        <a href="mailto:redacao@dealcrafting.com.br">redacao@dealcrafting.com.br</a>
        <a href="mailto:comercial@dealcrafting.com.br">Anuncie aqui</a>
        <a href="/sobre/">Sobre nós</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {{ hoje.ano }} deal.crafting. Todos os direitos reservados.</span>
      <span>Conteúdo ilustrativo para fins de protótipo.</span>
    </div>
  </div>
</footer>

<script src="/assets/site.js"></script>

<!-- Netlify Identity: precisa estar carregado aqui também (não só em /admin)
     porque os e-mails de convite/redefinição de senha levam pra raiz do site,
     não direto pro /admin. Sem isso, o link do convite não abre o popup. -->
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", function (user) {
      if (!user) {
        window.netlifyIdentity.on("login", function () {
          document.location.href = "/admin/";
        });
      }
    });
  }
</script>
</body>
</html>
